{
  "name": "innotrat-texteditor",
  "private": true,
  "version": "1.0.0",
  "author": "Innotrat Labs",
  "description": "InnoView IDE Desktop Application",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron:dev": "node electron/dev-runner.js",
    "electron:build": "vite build",
    "package:dir": "vite build && node electron/package-app.js",
    "package:exe": "node electron/package-app.js && electron-builder --win portable nsis --prepackaged release/win-unpacked",
    "dist": "vite build && node electron/package-app.js && electron-builder --win portable nsis --prepackaged release/win-unpacked",
    "dist:win": "vite build && node electron/package-app.js && electron-builder --win portable nsis --prepackaged release/win-unpacked",
    "lint": "eslint .",
    "preview": "vite preview",
    "clear-cache": "node -e \"localStorage.clear(); sessionStorage.clear();\" 2>/dev/null || echo 'Run in browser console: localStorage.clear(); sessionStorage.clear();'"
  },
  "dependencies": {
